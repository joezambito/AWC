# AWC – environment configuration template
#
# Copy this file to your device's Documents folder as "awc.env" and fill in
# the real values.  The awc.env file is listed in .gitignore and must NEVER
# be committed to source control.
#
# Usage (device):
#   1. Connect your device in Xcode or use the Files app.
#   2. Navigate to the AWC app's Documents folder.
#   3. Create a plain-text file named exactly:  awc.env
#   4. Paste the keys below and replace the placeholder values.
#
# Format rules:
#   • One KEY=value per line.
#   • Lines beginning with # are comments and are ignored.
#   • No spaces around the = sign.
#   • No quotes around values.

# Interactive Brokers TWS connection
IBKR_CLIENT_ID=77
IBKR_HOST=192.168.1.21
IBKR_PORT=7497

# Market data REST API (used by MarketDataFetcher)
MARKET_DATA_BASE_URL=https://api.example.com
